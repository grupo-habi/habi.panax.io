{
	"server": {
		"request": "${xover.session.server}/request.asp",
		"session": "POST ${xover.session.server}/session.asp",
		"login": "POST ${xover.session.server}/login.asp",
		"logout": "${xover.session.server}/logout.asp",
		"applyPermissions": {
			"POST server:request": { "FROM": "[$Security].[applyPermissions]" }
		},
		"crearRevision": {
			"POST server:request": { "FROM": "Interapas.crearRevision" }
		}
	},
	"session": {
		"server": "http://interapas.habi.com.mx/server"
	},
	"sources": {
		"^#([^?]+)(\\?.*)?": {
			"server:request": {
				"FROM": "PanaxBI.$1"
			}
		},
		"#": "#shell",
		"#shell": "default",
		"#login": "login.xml",
		"#loading": null,
		"/widgets/page_navbar.xslt": "/page_navbar.xslt",
		"/widgets/sitemap.xslt": "/sitemap.xslt",
		"#settings": "settings.xml",
		"px-to-excel": "/widgets/excel_button.xhtml",
		"px-refresh": "/widgets/refresh_button.xhtml",
		"excel-selection": "/widgets/$&.xhtml",
		"selection-summary": "/widgets/$&.xhtml",
		"value-filter": "/widgets/$&.xhtml",
		"^px-(.+)": "/widgets/$1.xhtml",
		"google-chart": "/widgets/google-chart.xhtml",
		"#menu": "menus.xml",
		"#globalization": [ "assets/globalization/headerText.${xo.session.locale.split('-').shift()}.resx", "assets/globalization/headerText.resx" ],
		"#sitemap": {
			"server:request": {
				"FROM": "Platform.Menu"
			}
		},
		"#reporte_interapas": {
			"server:request": {
				"FROM": "Interapas.reporte_interapas"
			}
		},
		"#reporte_complementos_faltantes": {
			"server:request": {
				"FROM": "Compras.reporteComplementosFaltantes"
			}
		},
		"#resumen_descarga_cfdi": {
			"server:request": {
				"FROM": "[DescargaMasiva].[reporteDescargaCFDI]"
			}
		}
	},
	"start": [
		"loading.xslt",
		"px-loader",
		{
			"updateTunnel": [],
			"@settings": {
				"resumable": true
			}
		},
		{
			"server:session": [],
			"@settings": {
				"resumable": true
			}
		},
		"px-qrcode",
		"#menu"
	],
	"settings": {
		"^#.*": {
			"headers": {
				"Cache-Control": "max-age=0",
				"x-debugging": "true",
				"expiry": 1
			}
		},
		"#reporte_interapas": {
			"target": "@#shell main",
			"headers": {
				"x-root-node": "model",
				"x-row-node": "row"
			}
		},
		"#reporte_complementos_faltantes": {
			"target": "@#shell main",
			"headers": {
				"x-root-node": "model",
				"x-row-node": "row"
			}
		},
		"~.asp": {
			"headers": {
				"authorization": "${xover.session.id_token}"
			}
		},
		"server:applyPermissions": {
			"headers": {
				"x-payload-parameter-name": "@input"
			}
		},
		"#shell": {
			"hash": ""
		}
	}
}
